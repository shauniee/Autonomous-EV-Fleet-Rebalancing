FLEET_URL=http://localhost:8001
DEMAND_URL=http://localhost:8002
TELEMETRY_INTERVAL_SECONDS=5
STALE_SECONDS=15
OFFLINE_SECONDS=30
MIN_RESERVE_PCT=20
ROUTE_FACTOR=1.3
ENERGY_MARGIN_FACTOR=1.15
DISTANCE_SCALE_KM=50
RECOMMENDATION_TTL_SECONDS=120
CHARGING_MAX_AGE_SECONDS=3600
REBALANCING_URL=http://localhost:8003
ACK_TIMEOUT_SECONDS=15
PROGRESS_TIMEOUT_SECONDS=30
RECONCILE_INTERVAL_SECONDS=1
ARRIVAL_TOLERANCE_KM=0.05
FLEET_PORT=8001
DEMAND_PORT=8002
REBALANCING_PORT=8003
DISPATCH_PORT=8004
DEMAND_SIMULATION_ENABLED=true
DEMAND_RANDOM_SEED=42
DEMAND_UPDATE_INTERVAL_SECONDS=30
DEMAND_MIN_DEMAND=0
DEMAND_MAX_DEMAND=20
DEMAND_MAX_STEP=3
DEMAND_MANUAL_HOLD_SECONDS=60
DEMAND_MAX_AGE_SECONDS=300
DEMAND_FLEET_SNAPSHOT_MAX_AGE_SECONDS=5
DEMAND_TELEMETRY_MAX_AGE_SECONDS=15
DEMAND_ZONE_RADIUS_KM=2
DEMAND_CRITICAL_SHORTAGE_RATIO=0.5
DEMAND_MEDIUM_DEMAND=5
DEMAND_HIGH_DEMAND=10
DEMAND_FLEET_TIMEOUT_SECONDS=2
# Operator dashboard (relocation profile)
DASHBOARD_PORT=8080
# Optional outside Kubernetes. Kubernetes supplies both values automatically.
# DATABASE_URL is for native processes; Compose uses COMPOSE_DATABASE_URL below.
DATABASE_URL=postgresql://ev_fleet:ev-fleet-local@localhost:5432/ev_fleet
# Optional existing database reachable inside Compose containers, for example
# postgresql://ev_fleet:ev-fleet-local@host.docker.internal:5432/ev_fleet
# Empty keeps the existing ephemeral demo; it cannot preserve recovery on restart.
COMPOSE_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
DASHBOARD_CACHE_ENABLED=true
DATABASE_CONNECT_ATTEMPTS=30
DATABASE_CONNECT_DELAY_SECONDS=1

# Facilities provider: MOCK for offline demos, LTA_DATAMALL for real observations.
# Keep the AccountKey backend-only. Never prefix it with VITE_.
FACILITIES_SOURCE=MOCK
LTA_DATAMALL_ACCOUNT_KEY=
LTA_PARKING_REFRESH_SECONDS=60
LTA_CHARGING_REFRESH_SECONDS=300
LTA_PARKING_MAX_AGE_SECONDS=180
LTA_CHARGING_MAX_AGE_SECONDS=900

# Optional OneMap driving routes. Uses a OneMap REST access token, not the LTA key.
# SIMULATED permits dashboard inspection only: no road route or dispatch
# recommendation can be completed. A local relocation demo requires ONEMAP
# with a fresh access token; never use a straight-line fallback as a road route.
# Each computer needs its own uncommitted .env and a normal startup to apply it.
ROUTING_PROVIDER=SIMULATED
ONEMAP_ACCESS_TOKEN=

# Optional live traffic ranking and route safety from LTA DataMall.
# Requires LTA_DATAMALL_ACCOUNT_KEY. Missing/stale data is shown as unknown.
TRAFFIC_SOURCE=DISABLED
# Optional local-only operator traffic-scenario controller, disabled by default.
# Never commit a real secret; only the backend receives this value.
TRAFFIC_SIMULATION_ENABLED=false
TRAFFIC_SIMULATION_CONTROL_KEY=
# 10x simulated time balances demonstrable motion and 1-second telemetry.
SIMULATION_TIME_SCALE=10
# Moving simulators only; stationary ev-01/ev-02 keep their existing telemetry path.
# Compose defaults enable these for its two moving nodes. Keep the Fleet allowlist
# and moving-node checkpoint flag consistent; native CLI users must export them.
SIMULATOR_RECOVERY_ENABLED=true
SIMULATOR_RECOVERY_VEHICLE_IDS=ev-moving-01,ev-moving-02
SIMULATOR_CHECKPOINTING_ENABLED=true
# Fleet uses SIMULATION_TIME_SCALE for checkpoint validation and charging bounds.
# Kubernetes uses k8s/configmaps.yaml, including explicit extra-simulator identities.
# Optional self-hosted OSRM HTTP base URL for road-safe alternatives at approval.
# Without OSRM, confirmed blocked OneMap routes are rejected, not bypassed.
OSRM_ROUTING_URL=

# CRDS is active by default; operator approval is still required for dispatch.
# ADVISORY prevents dispatch; DISABLED selects the legacy weighted policy.
CRDS_MODE=ACTIVE
CRDS_HORIZON_MINUTES=30
CRDS_SLOT_MINUTES=1
CRDS_MINIMUM_GAIN_VEHICLE_MINUTES=1
CRDS_DEADLINE_SECONDS=30
CRDS_EXECUTION_MODE=LOCAL
# Optional internal evaluators; use the crds-workers Compose profile separately.
CRDS_WORKER_URLS=http://crds-worker-a:8000,http://crds-worker-b:8000
CRDS_WORKER_TIMEOUT_SECONDS=5
# Research ablation only: false retains the objective/traffic/returns model without age expansion.
CRDS_EXPAND_AGE=true
